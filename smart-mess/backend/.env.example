# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Authentication (MUST be at least 32 characters, no placeholders)
JWT_SECRET=your_jwt_secret_min_32_chars_long_random_string_here
JWT_EXPIRES_IN=24h

# College Configuration
HOME_COLLEGE_NAME=National Institute of Technology

# Admin Seed Configuration (setup script creates/updates admin)
ADMIN_NAME=Mess Administrator
ADMIN_EMAIL=admin@mess.local
ADMIN_PASSWORD=AdminSecurePass123!

# Database Configuration (MySQL)
# Option A: Single Connection URI (e.g., TiDB Cloud, Aiven, Railway)
# DATABASE_URL=mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test

# Option B: Individual Parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smart_mess_db
DB_SSL=false # set to true for cloud MySQL providers (e.g. TiDB Cloud)

# Security & Limits
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_MAX=20

# Google OAuth Configuration (Google Identity Services)
# Domain restriction: Only accounts ending in @bitsathy.ac.in will be allowed
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
